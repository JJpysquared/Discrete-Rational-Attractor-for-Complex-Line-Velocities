import mpmath
from sympy import symbols, fraction

def cont_sum_critical_line(shape):
    """
    Generates coefficients using an integer historical-memory sequence.
    Keeps expressions strictly rational to leverage SymPy's fraction engine
    while applying an arithmetic brake to stabilize the acceleration curve.
    """
    n = symbols('n')
    coeff_sums = []
    symbolic_terms = []
    
    print("--- Phase 1: Generating Rational Coeffs ---")
    for k in range(2, shape):
        # Recommended Change: Use an integer modifier instead of a float log.
        # This acts as a structural brake without destroying the fraction numerator physics.
        integer_brake = (k // 2) + 1
        
        pieces = [n / (k * integer_brake), (k * integer_brake) * n]
        for c in coeff_sums:
            pieces.append(c * n)
            
        expr = sum(pieces)
        simplified_expr = expr / n
        coeff_sums.append(simplified_expr)
        symbolic_terms.append(simplified_expr)
        
    return symbolic_terms

def solve_and_verify_zeros(symbolic_terms, target_step):
    """
    Automates your balancing equation: T_k * n + Num(T_{k+1})/n - n = 0
    Extracts the pure integer numerators, handles the complex root, 
    and checks the proximity to true Riemann Zeta zeros.
    """
    # Set high precision for evaluating the zeta function at high altitudes
    mpmath.mp.dps = 30
    
    # Select our consecutive terms (T_k and T_{k+1})
    tk_expr = symbolic_terms[target_step - 2]
    tk_plus_1_expr = symbolic_terms[target_step - 1]
    
    # Programmatically extract the clean integer numerator from the next step
    num_tk_plus_1, _ = fraction(tk_plus_1_expr)
    
    # Convert SymPy symbols to high-precision mpmath floats
    c_k = mpmath.mpf(str(tk_expr))
    numerator_next = mpmath.mpf(str(num_tk_plus_1))
    
    # Solve your quadratic constraint: (c_k - 1)n^2 + numerator_next = 0
    # Because it forces a negative, n^2 = -numerator_next / (c_k - 1)
    # The imaginary height t is the square root of that absolute value
    n2 = -numerator_next / (c_k - 1)
    t_val = mpmath.sqrt(-n2)
    
    print(f"\n--- Results for Step T{target_step} -> T{target_step+1} ---")
    print(f"Calculated Coordinates (s) : 0.5 + {t_val}i")
    
    # Evaluate the Riemann Zeta function at your generated point
    s_coord = mpmath.mpc(0.5, t_val)
    zeta_output = mpmath.zeta(s_coord)
    print(f"Zeta Output at your point  : {zeta_output}")
    
    # Find the nearest true non-trivial zero using your value as a starting guess
    try:
        true_zero_t = mpmath.findroot(lambda t: mpmath.zeta(mpmath.mpc(0.5, t)).real, t_val)
        distance = abs(true_zero_t - t_val)
        print(f"Closest True Zero Height   : {true_zero_t}")
        print(f"Absolute Margin of Error   : {distance}")
    except Exception:
        print("Nearest true zero outside localized search limits.")

# Run the complete suite
if __name__ == "__main__":
    # Generate the terms
    terms = cont_sum_critical_line(shape=50)
    
    # Test a moderately high step to see the stabilized slingshot in action
    solve_and_verify_zeros(terms, target_step=20)
